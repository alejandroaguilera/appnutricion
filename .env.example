DATABASE_URL="postgresql://user:password@host:5432/appnutricion"

# Ruta al CSV histórico de peso (§10.4) — no se commitea al repo.
# Colocar el archivo manualmente antes de correr `npx prisma db seed`.
WEIGHT_CSV_PATH="./BodyComposition_202601-202607.csv"

# ── Estimación por IA (§3.2-D) ───────────────────────────────────────────
# Sin XAI_API_KEY y XAI_MODEL la app corre igual: el registro por texto/foto
# se guarda con estadoClasificacion=pendiente y se reclasifica cuando la IA
# vuelva a estar disponible. /api/estimate responde 503, nunca 500.
#
# NO adivinar el id del modelo: consultar los vigentes con
#   curl -H "Authorization: Bearer $XAI_API_KEY" https://api.x.ai/v1/models
# y verificar con GET /api/ai/health?probe=1 antes de darlo por bueno.
XAI_API_KEY=""
XAI_MODEL=""
XAI_VISION_MODEL=""
XAI_BASE_URL="https://api.x.ai/v1"

# Las notas de voz se transcriben con XAI_API_KEY contra /v1/stt — no hay
# variable aparte. Ese endpoint NO es el de OpenAI: /v1/audio/transcriptions
# responde 404 en xAI. Ver lib/ai/transcribe.ts.

# ── Telegram (§6) ────────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN: de @BotFather.
# TELEGRAM_CHAT_ID: el único chat autorizado; cualquier otro se ignora en
#   silencio, sin responder (§6.3).
# TELEGRAM_WEBHOOK_SECRET: cadena aleatoria propia; se valida contra el header
#   X-Telegram-Bot-Api-Secret-Token en cada petición.
# Registrar el webhook: POST /api/telegram/setup con el header x-jobs-secret.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_WEBHOOK_SECRET=""

# ── Trabajos programados ─────────────────────────────────────────────────
# JOBS_SECRET protege /api/jobs/tick, /api/telegram/setup y el probe de IA.
# SCHEDULER_ENABLED=0 apaga el reloj en proceso (útil en local).
JOBS_SECRET=""
APP_BASE_URL="https://appnutricion.mrhapps.mx"
SCHEDULER_ENABLED="1"
